# /opt/vanilla-tech/cd/cd.env — configuración del pipeline en la instancia (la escribe install.sh).
VT_BASE=/opt/vanilla-tech
VT_DATA=/opt/vanilla-tech/data
VT_MODPACK=/opt/vanilla-tech/modpacks/vanilla-tech.mrpack
VT_SERVICE=vanilla-tech
VT_CONTAINER=mc
VT_PORT=25565
VT_REGION=us-east-1
VT_BUCKET=REPLACE_ME                       # bucket del pack y de los backups del mundo
VT_RELEASE_URL=https://OWNER.github.io/REPO   # sitio estático con releases/<v>/
VT_KEEP_SNAPSHOTS=3                        # backups locales completos (mínimo 2)
VT_HEALTH_TIMEOUT=900
VT_MIN_FREE_MB=2048
VT_LOG_DIR=/var/log/vanilla-tech-cd       # logs de cada deploy/rollback
